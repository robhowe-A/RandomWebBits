@model RWBDotnetTypeScript.Pages.Guides.Devtools.cssoverviewtabModel
@{
    ViewData["Title"] = "GUIDE: Dev CSS Overview</RWB>";
}
@section guidesComponents
{
    <script type="module" src="~/src/guidesComponents.js"></script>
    <link rel="stylesheet" href="../../css/photoswipe.css">
}
<time datetime="2023-10-30">December 1, 2023</time>
<article id="CSSOverviewTab" class="WebBits">
    <h2>GUIDE: Dev Tools --&gt; CSS Overview Tab</h2>
    <p>
        Open the <abbr title="developer">dev</abbr> tools tab with
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>J</kbd></kbd> or with the
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>I</kbd></kbd> keyboard shortcut
        in Firefox. Navigate to the CSS
        Overview tab.
    </p>
    <figure class="imgShadow pictureCaption">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsCSSOverview.png"
           data-pswp-width="1078" data-pswp-height="904">
            <img src="../../library/img/DevToolsCSSOverview.png" alt="Default view of CSS Overview tab"
                 width="1078" height="904">
        </a>
        <figcaption>A default view of <q>CSS Overview</q> tab in developer's tools.</figcaption>
    </figure>
    <p>
        The default tab's view has instructions and a <q>Capture overview</q> button. Click the capture
        overview
        button. The page's <abbr title="Cascading Style Sheets">CSS</abbr> is analyzed and a result summary
        is
        shown relevant of the captured styles. An example shown below of <span data-rwb-type="link">
            <a href="../../pages"
               title="&lt;RWB&gt;"><b>&lt;RWB&gt;pages&lt;/RWB&gt;</b></a>
        </span>
        page
        styles, each section can be selected to review and find/fix according to the recommendations.
    </p>

    <!--Photoswipe start-->
    <div id="devTools-Gallery" class="devToolsGrid">
        <figure class="imgShadow pictureCaption img1">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsCSSOverview-Summary.png"
               data-pswp-width="1078" data-pswp-height="904">
                <img src="../../library/img/DevToolsCSSOverview-Summary.png"
                     alt="A highlighted view of css overview's summary" width="1078" height="904">
            </a>
            <figcaption>CSS Overview summary view.</figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img2">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsCSSOverview-Colors.png"
               data-pswp-width="1078" data-pswp-height="873">
                <img src="../../library/img/DevToolsCSSOverview-Colors.png"
                     alt="A highlighted view of css overview's colors" width="1078" height="873">
            </a>
            <figcaption>Colors highlighted in CSS Overview tools</figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img3">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsCSSOverview-Font.png"
               data-pswp-width="1078" data-pswp-height="873">
                <img src="../../library/img/DevToolsCSSOverview-Font.png"
                     alt="A highlighted view of css overview's font info" width="1078" height="873">
            </a>
            <figcaption>Font highlighted in CSS Overview tools</figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img4">
            <a class="pswp-gallery__item"
               href="../../library/img/DevToolsCSSOverview-UnusedDeclarationsMediaQueries.png"
               data-pswp-width="1078" data-pswp-height="873">
                <img src="../../library/img/DevToolsCSSOverview-UnusedDeclarationsMediaQueries.png"
                     alt="A highlighted view of css overview's unused declarations and media queries"
                     width="1078" height="873">
            </a>
            <figcaption>Unused declarations and media queries highlighted in CSS Overview tools</figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img5">
            <a class="pswp-gallery__item"
               href="../../library/img/DevToolsCSSOverview-SelectorPerformance.png" data-pswp-width="1078"
               data-pswp-height="871">
                <img src="../../library/img/DevToolsCSSOverview-SelectorPerformance.png"
                     alt="A highlighted view of css overview's non-simple selectors" width="1078"
                     height="871">
            </a>
            <figcaption>Selector performance highlighted in CSS Overview tools</figcaption>
        </figure>
    </div>
    <div class="exampleBlue">
        <p>CSS Overview is only in Edge browser.</p>
    </div>
</article>
<div class="Top-Link"><a class="Top" href="/guides/devtools/cssoverviewtab#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("main").setAttribute("id", "DevTools");
        document.querySelector("body").classList.add("WebBits-width");
    </script>
}