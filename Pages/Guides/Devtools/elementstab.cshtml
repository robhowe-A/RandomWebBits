@model RWBDotnetTypeScript.Pages.Guides.Devtools.elementstabModel
@{
    ViewData["Title"] = "GUIDE: Dev Elements</RWB>";
}
@section guidesComponents
{
    <script type="module" src="/src/guidesComponents.js"></script>
    <link rel="stylesheet" href="../../css/photoswipe.css">
}
<time datetime="2023-10-28">October 28, 2023</time>
<article id="ElementsTab" class="WebBits">
    <h2>GUIDE: Dev Tools --&gt; Elements Tab</h2>
    <p>
        Open the <abbr title="developer">dev</abbr> tools tab with
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>J</kbd></kbd> and navigate to the
        elements tab. In firefox, be sure to use
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>I</kbd></kbd>
    </p>
    <figure class="imgShadow pictureCaption">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsElementsOpen.png" data-pswp-width="1913"
           data-pswp-height="820">
            <img src="../../library/img/DevToolsElementsOpen.png"
                 alt="A default view of Elements tab in developer's tools." width="1913" height="820">
        </a>
        <figcaption>
            A default view of <q>Elements</q> tab in developer's tools.
        </figcaption>
    </figure>
    <p>
        All of the DOM elements are viewable in a tree structure. See
        <span data-rwb-type="link"><a href="/pages/dom" title="DOM&lt;/RWB&gt;">&lt;DOM&gt;</a></span>
        for more details. Elements' CSS properties are visible in the right
        part of the panel's display.
    </p>

    <figure class="imgShadow pictureCaption">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsElementsOption.png" data-pswp-width="1911"
           data-pswp-height="820">
            <img src="../../library/img/DevToolsElementsOption.png"
                 alt="View individual css atribute rules in the Computed tab." width="1911" height="820">
        </a>
        <figcaption>
            View individual css atribute rules in the <q>Computed</q> tab.
        </figcaption>
    </figure>
    <p>
        Below, the elements tab surfaces &lpar;varying&rpar; problems and uses
        the console to display errors and warnings, as pictured here:
    </p>
    <div class="devToolsGrid">
        <figure class="imgShadow pictureCaption img1">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsElementsErrorsandWarnings.png"
               data-pswp-width="277" data-pswp-height="65">
                <img src="../../library/img/DevToolsElementsErrorsandWarnings.png"
                     alt="Elements tab errors and warnings icon." width="277" height="65">
            </a>
            <figcaption class="pictureCaption">
                Elements tab errors and warnings icon.
            </figcaption>
        </figure>
        <figure class="imgShadow pictureCaption">
            <a class="pswp-gallery__item img2" href="../../library/img/DevToolsElementsErrorsandWarningsConsole.png"
               data-pswp-width="1506" data-pswp-height="666">
                <img src="../../library/img/DevToolsElementsErrorsandWarningsConsole.png"
                     alt="A zoomed in view of elements errors and warnings." width="1506" height="666">
            </a>
            <figcaption>
                A zoomed in view of elements errors and warnings.
            </figcaption>
        </figure>
    </div>
    <aside class="exampleBlue">
        <p>
            If the page is without console errors, the button does not appear.
        </p>
    </aside>
    <hr>
    <p>
        <strong>Additionally: </strong>A part of development is making sure
        the markup adheres to the browser's specifications and writing
        standards. Clicking the blue comment bubble opens a list of
        recommendations for improvement. This option is not available in
        firefox browser.
    </p>
    <p class="truebluebold note">
        <em>Note:</em>"Improvements" is shown in Chromium's developer toolset,
        so use Edge or Chrome to see the feature.
    </p>
    <!--Photoswipe start-->
    <figure class="imgShadow pictureCaption">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsElementsIssuesandImprovements.png"
           data-pswp-width="1506" data-pswp-height="820">
            <img src="../../library/img/DevToolsElementsIssuesandImprovements.png"
                 alt="Improvement suggestions view in the elements tab." width="1506" height="820">
        </a>
        <figcaption>
            Improvement suggestions view in the elements tab.
        </figcaption>
    </figure>
    <aside class="exampleBlue">
        <p>
            Examples are using <em>Edge</em> browser. <em>Chrome</em> and
            <em>Firefox</em> use similar keyboard shortcuts and application
            layout information.
        </p>
    </aside>
</article>
<div class="Top-Link"><a class="Top" href="/guides/devtools/elementstab#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("main").setAttribute("id", "DevTools");
        document.querySelector("body").classList.add("WebBits-width");
    </script>
}