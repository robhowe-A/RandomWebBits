@model RWBDotnetTypeScript.Pages.Guides.Devtools.memorytabModel
@{
    ViewData["Title"] = "GUIDE: Dev Memory</RWB>";
}
@section guidesComponents
{
    <script type="module" src="/src/guidesComponents.js"></script>
    <link rel="stylesheet" href="../../css/photoswipe.css">
}
<time datetime="2023-11-02">November 2, 2023</time>
<article id="MemoryTab" class="WebBits">
    <h2>GUIDE: Dev Tools --&gt; Memory Tab</h2>
    <p>
        Open the <abbr title="developer">dev</abbr> tools tab with
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>J</kbd></kbd> and navigate to the
        memory tab. In firefox, be sure to use
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>I</kbd></kbd>
    </p>
    <figure class="imgShadow pictureCaption img1">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsMemory0.png" data-pswp-width="1912"
           data-pswp-height="954">
            <img src="../../library/img/DevToolsMemory0.png" alt="A default view of 'Memory' tab in developer's tools."
                 width="1912" height="954">
        </a>
        <figcaption>
            A default view of <q>Memory</q> tab in developer's tools.
        </figcaption>
    </figure>
    <p>
        Take a snapshot of a favorite web page. A snapshot is like an instant
        copy, and a heap snapshot of memory from a web browser will include
        all DOM elements.
    </p>
    <figure class="imgShadow pictureCaption gap">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsMemory1.png" data-pswp-width="1111"
           data-pswp-height="953">
            <img src="../../library/img/DevToolsMemory1.png" alt="Edge browser's heap snapshot of dom page."
                 width="1111" height="953">
        </a>
        <figcaption>
            Edge browser's heap snapshot of dom page.
        </figcaption>
    </figure>
    <!--Photoswipe start-->
    <div id="devTools-Gallery" class="devToolsGrid">
        <figure class="imgShadow pictureCaption img1 gap">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsMemory2.png" data-pswp-width="126"
               data-pswp-height="114">
                <img src="../../library/img/DevToolsMemory2.png" alt="LocalStorage before clearing browser data"
                     width="126" height="114">
            </a>
            <figcaption>
                Switch the memory tab view to statistics &lpar;Edge&rpar;
            </figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img2">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsMemory3.png" data-pswp-width="1110"
               data-pswp-height="954">
                <img src="../../library/img/DevToolsMemory3.png" alt="Heap snapshot pie chart (Edge)" width="1110"
                     height="954">
            </a>
            <figcaption>
                Heap snapshot pie chart &lpar;Edge Browser&rpar;
            </figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img3">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsMemory4.png" data-pswp-width="1120"
               data-pswp-height="948">
                <img src="../../library/img/DevToolsMemory4.png" alt="Heap snapshot tree map (Firefox)" width="1120"
                     height="948">
            </a>
            <figcaption>
                The view of heap snapshot in firefox developer tools shows a tree
                map
            </figcaption>
        </figure>
    </div>
    <hr>
    <p>
        <strong>Info: </strong>Firefox's memory tab has a call stack option.
        Depicted below is a nested function from main that expands the view of
        list items when clicked.
    </p>
    <aside class="exampleBlue">
        <p>
            The page's custom code call stack starts below at
            init:typescript.js:10721:16. <br>Then main --&gt; init --&gt;
            CheckPage --&gt; init --&gt; ExpandingListElement
            &lpar;highlighted&rpar;
        </p>
    </aside>
    <!--Example 3 picture (RWB, zoom or highlight)-->
    <figure class="imgShadow pictureCaption">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsMemory5.png" data-pswp-width="1920"
           data-pswp-height="947">
            <img src="../../library/img/DevToolsMemory5.png" alt="A view of the heap snapshot's call stack in Firefox"
                 width="1920" height="947">
        </a>
        <figcaption>
            A view of the heap snapshot's call stack in Firefox
        </figcaption>
    </figure>
</article>
<div class="Top-Link"><a class="Top" href="/guides/devtools/memorytab#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("main").setAttribute("id", "DevTools");
        document.querySelector("body").classList.add("WebBits-width");
    </script>
}