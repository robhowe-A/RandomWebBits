@model RWBDotnetTypeScript.Pages.Guides.Devtools.networktabModel
@{
    ViewData["Title"] = "GUIDE: Dev Network</RWB>";
}
@section guidesComponents
{
    <script type="module" src="/src/guidesComponents.js"></script>
    <link rel="stylesheet" href="../../css/photoswipe.css">
}
<time datetime="2023-10-31">October 31, 2023</time>
<article id="NetworkTab" class="WebBits">
    <h2>GUIDE: Dev Tools --&gt; Network Tab</h2>
    <p>
        Open the <abbr title="developer">dev</abbr> tools tab with
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>J</kbd></kbd> and navigate to the
        network tab. In firefox, be sure to use
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>I</kbd></kbd>
    </p>
    <figure class="imgShadow pictureCaption img1">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsNetwork.png" data-pswp-width="1920"
           data-pswp-height="804">
            <img src="../../library/img/DevToolsNetwork.png" alt="Developer's tools 'Network' tab default view."
                 width="1920" height="804">
        </a>
        <figcaption>
            Developer's tools <q>Network</q> tab default view.
        </figcaption>
    </figure>
    <p>
        Network panel provides details and insights of a website's remote
        operation. Because files need to be downloaded from a web server,
        details specific to individual file transport are presented throughout
        the panel's interaction.
    </p>
    <!--Photoswipe start-->
    <aside class="exampleBlue">
        <p>
            Examples below are using <em>Edge</em> browser. <em>Chrome</em> and
            <em>Firefox</em> share similar information and options.
        </p>
    </aside>
    <div id="devTools-Gallery" class="devToolsGrid">
        <figure class="imgShadow pictureCaption img1">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsNetwork0.png" data-pswp-width="1918"
               data-pswp-height="955">
                <img src="../../library/img/DevToolsNetwork0.png"
                     alt="Click the filter icon to open and close the filter options bar" width="1918" height="955">
            </a>
            <figcaption>
                Click the filter icon to open and close the filter options bar
            </figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img2">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsNetwork1-filter.png" data-pswp-width="1920"
               data-pswp-height="804">
                <img src="../../library/img/DevToolsNetwork1-filter.png" alt="Filter the list by file extension type"
                     width="1920" height="804">
            </a>
            <figcaption>
                Filter the list by file extension type<br>More status code
                information is found at
                <span data-rwb-type="link">
                    <a href="/pages/htmlresponses"
                       title="HTML Frames&lt;/RWB&gt;">
                        &lt;HTML
                        Frames&gt;
                    </a>
                </span>.
            </figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img3">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsNetwork1-filterDetail.png"
               data-pswp-width="1920" data-pswp-height="804">
                <img src="../../library/img/DevToolsNetwork1-filterDetail.png"
                     alt="'Waterfall' details show specific file transport statistics" width="1920" height="804">
            </a>
            <figcaption>
                <q>Waterfall</q> details show specific file transport statistics
            </figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img4">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsNetwork2-networkConditions.png"
               data-pswp-width="1920" data-pswp-height="805">
                <img src="../../library/img/DevToolsNetwork2-networkConditions.png"
                     alt="Click More network conditions icon to navigate to the network conditions console tab option"
                     width="1920" height="805">
            </a>
            <figcaption>
                Click <q>More network conditions</q> icon to navigate to the
                network conditions console tab option
            </figcaption>
        </figure>
    </div>
    <p>
        If the findings are needed analyzed at a later time or viewed
        elsewhere, the import and export &lpar;HAR&rpar; options allow saving
        and re-viewing the network data through the import and export HAR
        functionality.
    </p>
    <figure class="imgShadow pictureCaption img1">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsNetwork-exportHAR.png" data-pswp-width="1920"
           data-pswp-height="804">
            <img src="../../library/img/DevToolsNetwork-exportHAR.png" alt="Save the records as a .HAR file"
                 width="1920" height="804">
        </a>
        <figcaption>Save the records as a .HAR file</figcaption>
    </figure>
</article>
<div class="Top-Link"><a class="Top" href="/guides/devtools/networktab#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("main").setAttribute("id", "DevTools");
        document.querySelector("body").classList.add("WebBits-width");
    </script>
}