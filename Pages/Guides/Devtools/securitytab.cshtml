@model RWBDotnetTypeScript.Pages.Guides.Devtools.securitytabModel
@{
    ViewData["Title"] = "GUIDE: Dev Security</RWB>";
}
@section guidesComponents
{
    <script type="module" src="/src/guidesComponents.js"></script>
    <link rel="stylesheet" href="../../css/photoswipe.css">
}
<time datetime="2023-11-03">November 3, 2023</time>
<article id="SecurityTab" class="WebBits">
    <h2>GUIDE: Dev Tools --&gt; Security Tab</h2>
    <p>
        Open the <abbr title="developer">dev</abbr> tools tab with
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>J</kbd></kbd> and navigate to the
        security tab. A <q>Security</q> tab does not exist in Firefox.
    </p>
    <p>
        <strong>Microsoft Edge</strong> and
        <strong>Google Chrome</strong> support this in the dev tools.
    </p>
    <figure class="imgShadow pictureCaption">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsSecurity0.png" data-pswp-width="1110"
           data-pswp-height="954">
            <img src="../../library/img/DevToolsSecurity0.png" alt="Developer's tools 'Security' tab default view."
                 width="1110" height="954">
        </a>
        <figcaption>
            A default view of <q>Security</q> tab in developer's tools.
        </figcaption>
    </figure>
    <p>
        A details summary of the current page is provided. Also, cryptography
        algorithm information about the
        <abbr title="HyperText Transport Protocol Secure">HTTPS</abbr>
        certificate and
        <abbr title="Transport Layer Security 1.3">TLS 1.3</abbr> connection
        is given.
    </p>
    <figure class="imgShadow pictureCaption">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsSecurity.png" data-pswp-width="1110"
           data-pswp-height="954">
            <img src="../../library/img/DevToolsSecurity.png" alt="HTTPS certificate details." width="1110"
                 height="954">
        </a>
        <figcaption>Individual site details.</figcaption>
    </figure>
    <aside class="exampleBlue">
        <p>
            Clicking "Open full certificate details" opens the same panel as
            opening it via the
            <abbr title="Uniform Resource Locator">URL</abbr> icon option.<br><br>Go
            to
            <span data-rwb-type="link">
                <a href="/guides/https" title="GUIDE: HTTPS&lt;/RWB&gt;">
                    &lt;GUIDE:
                    HTTPS&gt;
                </a>
            </span>
            for more.
        </p>
    </aside>
</article>
<div class="Top-Link"><a class="Top" href="/guides/devtools/securitytab#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("main").setAttribute("id", "DevTools");
        document.querySelector("body").classList.add("WebBits-width");
    </script>
}