@model RWBDotnetTypeScript.Pages.Guides.Devtools.sourcestabModel
@{
    ViewData["Title"] = "GUIDE: Dev Sources</RWB>";
}
@section guidesComponents
{
    <script type="module" src="~/src/guidesComponents.js"></script>
    <link rel="stylesheet" href="../../css/photoswipe.css">
}
<time datetime="2023-10-30">October 30, 2023</time>
<article id="SourcesTab" class="WebBits">
    <h2>GUIDE: Dev Tools --&gt; Sources Tab</h2>
    <p>
        Open the <abbr title="developer">dev</abbr> tools tab with
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>J</kbd></kbd> or with the
        <kbd><kbd>CTRL</kbd>&nbsp;+&nbsp;<kbd>SHIFT</kbd>&nbsp;+&nbsp;<kbd>I</kbd></kbd> keyboard shortcut in
        Firefox. Navigate to the sources tab. Here, try making the screen
        large.
    </p>
    <figure class="imgShadow pictureCaption">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsSources-RWBdom1.png" data-pswp-width="1912"
           data-pswp-height="820">
            <img src="../../library/img/DevToolsSources-RWBdom1.png" alt="Developer's tools sources tab screen capture."
                 width="1912" height="820">
        </a>
        <figcaption>
            A default view of <q>Sources</q> tab in developer's tools.
        </figcaption>
    </figure>
    <figure class="imgShadow pictureCaption gap">
        <a class="pswp-gallery__item" href="../../library/img/DevToolsSources-RWBdom0.png" data-pswp-width="1916"
           data-pswp-height="859">
            <img src="../../library/img/DevToolsSources-RWBdom0.png" alt="Developer's tools sources tab screen capture."
                 width="1916" height="859">
        </a>
        <figcaption>
            The navigation panel shows the files downloaded from the web server.
            <br><strong>Shown:</strong> src --&gt; components --&gt;
            ExpandingListDOMWidget.ts
        </figcaption>
    </figure>
    <p>
        Multiple panels are able to collapse, and the console can be closed
        and opened, too. Below, the panel is used to debug the widget.
    </p>

    <!--Photoswipe start-->
    <div id="devTools-Gallery" class="devToolsGrid">
        <figure class="imgShadow pictureCaption img1">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsSources-RWBdom2.png" data-pswp-width="1916"
               data-pswp-height="858">
                <img src="../../library/img/DevToolsSources-RWBdom2.png" alt="A breakpoint added to the typescript file"
                     width="1916" height="858">
            </a>
            <figcaption>Add breakpoints in the main panel.</figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img2">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsSources-RWBdom3.png" data-pswp-width="1915"
               data-pswp-height="858">
                <img src="../../library/img/DevToolsSources-RWBdom3.png"
                     alt="The sources console appearing different with a breakpoint applied" width="1915" height="858">
            </a>
            <figcaption>
                With breakpoints, the panels adjust with the current runtime.
            </figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img3">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsSources-RWBdom4.png" data-pswp-width="1916"
               data-pswp-height="858">
                <img src="../../library/img/DevToolsSources-RWBdom4.png"
                     alt="Highlight of the console use during a breakpoint use" width="1916" height="858">
            </a>
            <figcaption>
                Use the console to access variables and JavaScript methods.
            </figcaption>
        </figure>
        <figure class="imgShadow pictureCaption img4">
            <a class="pswp-gallery__item" href="../../library/img/DevToolsSources-RWBdom5.png" data-pswp-width="1716"
               data-pswp-height="820">
                <img src="../../library/img/DevToolsSources-RWBdom5.png"
                     alt="Highlight of scope and call stack in the panel on the right" width="1716" height="820">
            </a>
            <figcaption>
                View local and global variables and the call stack in the panel on
                the right.
            </figcaption>
        </figure>
    </div>
    <!--https://learn.microsoft.com/en-us/microsoft-edge/devtools-guide-chromium/sources/-->
</article>
<div class="Top-Link"><a class="Top" href="/guides/devtools/sourcestab#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("main").setAttribute("id", "DevTools");
        document.querySelector("body").classList.add("WebBits-width");
    </script>
}