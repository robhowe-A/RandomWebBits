@model RWBDotnetTypeScript.Pages.Guides.inspectpagesModel
@{
    ViewData["Title"] = "GUIDE: Inspect Pages</RWB>";
}
@section guidesComponents
{
    <script type="module" src="/src/guidesComponents.js"></script>
    <link rel="stylesheet" href="../../css/photoswipe.css">
}
<time datetime="2023-04-10">April 10, 2023</time>
<article id="InspectPages" class="WebBits">
    <h2>GUIDE: Dev Tools --&gt; Inspect Pages</h2>
    <p>
        Opening the browser's developer toolset can be done in many ways.
        Multiple key binding combinations or even selecting the option from
        the settings will do the trick. In the <em>edge</em> browser, you
        can follow this quick bit: <kbd>&lpar;<kbd>Alt</kbd>&nbsp;+&nbsp;<kbd>F</kbd>&rpar;&nbsp;+&nbsp;<kbd>L</kbd>&nbsp;+&nbsp;<kbd>S</kbd> --&gt; type&nbsp;<code>edge://inspect</code></kbd>
    </p>
    <figure class="imgShadow pictureCaption">
        <img src="../library/img/Edge-Inspect_winshiftf.png" alt="Application tab in dev tools.">
        <figcaption>Edge browser search bar</figcaption>
    </figure>
    <p>
        With the <abbr title="developer">DEV</abbr> tools open, development
        may resume, until a separate tab needs to be opened. The process needs
        to be repeated for each tab. This can slow productivity, so an even
        faster method can be used to navigate tabs quickly, directly into the
        dev tools. Introducing the
        <abbr title="Uniform Resource Locator">URL</abbr> as such:
        <span class="url">edge://inspect/#pages</span>
    </p>
    <hr>
    <h3>Open inspection panel:</h3>
    <ol id="inspectSteps">
        <li>
            <strong>Step 1:</strong> Navigate to <span class="url">edge://inspect</span><br>
        </li>
        <li>
            <strong>Step 2:</strong> Click to open the <q>Pages</q> page<br>
        </li>
        <li>
            <strong>Step 3:</strong> Click <q>inspect</q> to jump to that page
            with network inspection open
        </li>
    </ol>
    <!--Photoswipe start-->
    <div id="inspectPages-Gallery" class="devToolsGrid">
        <figure class="pictureCaption img1">
            <a class="pswp-gallery__item" href="../library/img/Edge-Inspect.png" data-pswp-width="960"
               data-pswp-height="1032">
                <img src="../library/img/Edge-Inspect.png" alt="LocalStorage before clearing browser data" width="480"
                     height="516">
            </a>
            <figcaption>
                <strong>Step 1:</strong> Edge and chrome browsers each open the
                <q>Devices</q> page first
            </figcaption>
        </figure>
        <figure class="pictureCaption img2">
            <a class="pswp-gallery__item" href="../library/img/Edge-Inspect_inspect.png" data-pswp-width="960"
               data-pswp-height="1032">
                <img src="../library/img/Edge-Inspect_inspect.png" alt="LocalStorage after clearing browser data"
                     width="480" height="516">
            </a>
            <figcaption>
                <strong>Step 2:</strong> Nineteen tabs are open in relation to
                DNS.<br><strong>Note:</strong> each page has an inspect and a
                pause button.
            </figcaption>
        </figure>
        <figure class="pictureCaption img3">
            <a class="pswp-gallery__item" href="../library/img/Edge-Inspect_inspected-page.png" data-pswp-width="960"
               data-pswp-height="1032">
                <img src="../library/img/Edge-Inspect_inspected-page.png" alt="Cookies after clearing browser data"
                     width="480" height="516">
            </a>
            <figcaption>
                <strong>Step 3:</strong> After clicking inspect, the page is
                opened with the dev tools at the Network tab.
            </figcaption>
        </figure>
    </div>
    <aside class="examplePink">
        <p>
            Both <b>Google Chrome</b> and <b>Edge</b> operate the
            <em>chromium</em> browser engine, so each browser has this
            option.<br><br><code>chrome://inspect/#pages</code> or
            <code>edge://inspect/#pages</code>
        </p>
    </aside>
    <hr>
    <h3>Monitor browser processes</h3>
    <p>
        <strong>Step 4: &lpar;Optional&rpar;</strong>
        <kbd><kbd>Shift</kbd>&nbsp;+&nbsp;<kbd>Esc</kbd></kbd> opens the browser task manager. The
        process ID <abbr title="Process ID">&lpar;PID&rpar;</abbr> matches
        that found in the details tab of the
        <abbr title="Operating System">OS</abbr> task manager.
    </p>
</article>
<div class="Top-Link"><a class="Top" href="/guides/inspectpages#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("body").classList.add("WebBits-width");
    </script>
}