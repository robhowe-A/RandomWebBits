@model RWBDotnetTypeScript.Pages.Guides.pwaiconModel
@{
    ViewData["Title"] = "GUIDE: PWA</RWB>";
}
@section guidesComponents
{
    <link rel="stylesheet" href="../css/slideshow.css" type="text/css" media="all">
    <script type="module" src="~/src/guidesComponents.js"></script>
    <link rel="stylesheet" href="../../css/photoswipe.css">
}
<time datetime="2023-05-27">May 27, 2023</time>
<article id="PWA" class="WebBits">
    <h2>GUIDE: Utilizing PWA installation</h2>
    <p>
        <strong>Progressive Web Applications</strong>,
        <abbr title="Progressive Web Application">PWA</abbr>, are web
        applications <em><u>and</u></em> desktop applications made available
        by having one code base. Pwas are becoming more common as
        <abbr title="HyperText Markup Language version 5">HTML5</abbr>
        integrates more and more. Take advantage of pwa on your
        <abbr title="Personal Computer">PC</abbr> with Edge browser option
        <em><q>Install as an App</q></em>
    </p>

    <div id="Instructions">
        <hr>
        <h3>Install As An App:</h3>
        <p><strong>Step 1: </strong>Open settings --&gt; Apps</p>
        <p>
            <strong>Step 2: </strong>Click
            <em><q>Install this site as an app</q></em>
        </p>
        <figure class="imgShadow">
            <figcaption class="pictureCaption">
                Edge browser: settings at <i>mail.google.com</i>
            </figcaption>
            <a class="pswp-gallery__item" href="../library/img/PWA-InstallAsAnApp.png" data-pswp-width="958"
               data-pswp-height="885">
                <img src="../library/img/PWA-InstallAsAnApp.png" alt="Edge option: Install this site as an app."
                     width="958" height="885">
            </a>
        </figure>
        <aside class="exampleBlue">
            <p>
                Setting's <strong><i>Apps</i></strong> option is only available if
                the web application is a pwa.<sup>1</sup>
            </p>
        </aside>
        <hr>
        <p>
            <strong>Step 3 &lpar;Options&rpar;: </strong>Configure shortcut
            location&lpar;s&rpar; and/or launch behavior.
        </p>
        <div class="slideshow-container">
            <div class="mySlides fade">
                <figure class="imgShadow">
                    <a class="pswp-gallery__item" href="../library/img/PWA2-AppInstalled.png" data-pswp-width="922"
                       data-pswp-height="856">
                        <img src="../library/img/PWA2-AppInstalled.png"
                             alt="PWA application: launch options configuration panel." width="922" height="856">
                    </a>
                    <figcaption class="pictureCaption">
                        Installed application launch options<br>
                    </figcaption>
                </figure>
            </div>
            <div class="mySlides fade">
                <figure class="imgShadow">
                    <a class="pswp-gallery__item" href="../library/img/PWA3-AppLaunched.png" data-pswp-width="958"
                       data-pswp-height="885">
                        <img src="../library/img/PWA3-AppLaunched.png" alt="PWA application: full view." width="958"
                             height="885">
                    </a>
                    <figcaption class="pictureCaption">
                        Installed application<br>
                    </figcaption>
                </figure>
            </div>
            <!-- Next and previous buttons -->
            <a class="slideshowPrev">&#10094;</a>
            <a class="slideshowNext">&#10095;</a>

            <!-- The dots/circles -->
            <div style="text-align: center">
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
        </div>
        <hr>
        <p>
            <strong>Review: </strong>That's it! Now you have the website as an
            desktop application.
        </p>
        <ul>
            <li>Launch the application standalone</li>
            <li>Sign-in is the same as in a browser</li>
            <li>Experience is the same as in a browser</li>
        </ul>
        <figure class="imgShadow">
            <figcaption class="pictureCaption">Before</figcaption>
            <a class="pswp-gallery__item" href="../library/img/PWA4-TaskbarBefore.png" data-pswp-width="958"
               data-pswp-height="40">
                <img src="../library/img/PWA4-TaskbarBefore.png" alt="Taskbar look before installation." width="958"
                     height="40">
            </a>
        </figure>
        <figure class="imgShadow">
            <figcaption class="pictureCaption">After</figcaption>
            <a class="pswp-gallery__item" href="../library/img/PWA4-TaskbarAfter.png" data-pswp-width="958"
               data-pswp-height="40">
                <img src="../library/img/PWA4-TaskbarAfter.png" alt="Taskbar look after installation." width="958"
                     height="40">
            </a>
        </figure>
        <p class="citations">
            <strong>Citations:</strong><br>
            <sup>[1]</sup>
            <cite>
                <a href="https://support.microsoft.com/en-us/topic/install-manage-or-uninstall-apps-in-microsoft-edge-0c156575-a94a-45e4-a54f-3a84846f6113"
                   target="_blank" rel="external noopener"
                   title="Install, manage, or uninstall apps in Microsoft Edge - Microsoft Support">
                    <q>Microsoft Support</q>
                </a>
            </cite>
        </p>
    </div>
</article>
<div class="Top-Link"><a class="Top" href="/guides/pwaicon#top">Top</a></div>
