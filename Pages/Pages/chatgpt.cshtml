@model RWBDotnetTypeScript.Pages.Pages.chatgptModel
@{
    ViewData["Title"] = "chatGPT Test</RWB>";
}
@section pagesComponents
{
    <script type="module" src="~/src/pagesComponents.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/google/code-prettify@master/loader/run_prettify.js?lang=css&amp;skin=sons-of-obsidian"></script>
    <link rel="stylesheet" href="~/css/photoswipe.css">
}
<time datetime="2023-01-28">January 28, 2023</time>
<article id="chatGPT" class="WebBits">
    <h2>TRY: Previewing chatGPT</h2>
    <p>
        A first attempt of
        <a href="https://chat.openai.com/chat" target="_blank" title="chatGPT" rel="external noopener nofollow">chatGPT</a>
        may get an error or wrong results.
    </p>
    <figure class="imgShadow pictureCaption chatGPT">
        <a class="pswp-gallery__item" href="../library/img/chatGPT_First.jpeg" data-pswp-width="600"
           data-pswp-height="819">
            <img src="../library/img/chatGPT_First.jpeg" alt="Chat GPT conversation attempt showing error" width="600"
                 height="819">
        </a>
    </figure>
    <p>
        Reattempting the same question prompt
        <i><q>How do I make an HTTP request in Javascript?</q></i> was very
        descriptive and informative. In fact, the discussion was accurate and
        provided a nice format. The conversation is in the below markup:
    </p>
    <figure class="imgShadow pictureCaption chatGPT">
        <a class="pswp-gallery__item" href="../library/img/chatGPT_Second.jpeg" data-pswp-width="600"
           data-pswp-height="819">
            <img src="../library/img/chatGPT_Second.jpeg" alt="Chat GPT screenshot working example" width="600"
                 height="819">
        </a>
    </figure>
    <hr>
    <aside class="exampleBlue">
        <p>
            The example fetch request URLs have been changed to vary the API
            usage. This example calls the open API called
            <strong><q>An API of Ice and Fire</q></strong>
        </p>
    </aside>
    <div id="GPT">
        <p>
            There are several ways to make an HTTP request in JavaScript, but
            one of the most popular is using the <code>fetch()</code> function.
        </p>
        <p>
            Here's an example of how you can use <code>fetch()</code> to make a
            GET request to an API:
        </p>
        <pre class="prettyprint linenums"><code>fetch('https://anapioficeandfire.com/api/characters/1770')
    .then(response => response.json())
    .then(data => console.log(data))
    .catch(error => console.error(error));</code></pre>
        <p>
            This example uses the <code>fetch()</code> function to make a GET
            request to the url
            <a href="https://anapioficeandfire.com/" target="_blank" rel="external noopener"
               title="An API of Ice and Fire">anapioficeandfire.com</a>. The <code>then()</code> method is called with a
            callback function
            that logs the response data in the console, and the
            <code>catch()</code> method logs any errors that occur.
        </p>
    </div>
</article>
<div class="Top-Link"><a class="Top" href="/pages/chatgpt#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("body").classList.add("WebBits-width");
    </script>
}