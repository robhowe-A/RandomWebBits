@page
<!--Copyright (c) 2025-2026 Robert A. Howell-->
@model RWBDotnetTypeScript.Pages.Pages.dictionarywordModel
@using RWBDotnetTypeScript.Interop;
@{
    ViewData["Title"] = "Dictionary Word</RWB>";
}
@section pagesComponents
{
    <script type="module" src="~/src/pagesComponents.js"></script>
    <!-- FontAwesome -->
    <script src="https://kit.fontawesome.com/91ce0b8975.js" crossorigin="anonymous"></script>
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)"
               render-mode="ServerPrerendered" />
}
@(await Html.RenderComponentAsync<ClientApiRequest>(RenderMode.Server))
<time datetime="2023-01-30">January 30, 2023</time>
<aside class="exampleBlue dictionaryWidget">
    <p>Search a dictionary word to return results in the below web part.</p>
    <div id="screensize"></div>
</aside>
<div class="Top-Link"><a class="Top" href="/pages/dictionaryword#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("body").classList.add("WebBits-width");
    </script>
    <script type="module" src="~/Interop/ClientApiRequest.razor.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start({
          circuit: {
            configureSignalR: function (builder) {
              builder.configureLogging("warning");
            }
          }
        });
    </script>
}
@section widgetComponents
{
    <script type="module" src="~/src/widgetComponents.js"></script>
}