@model RWBDotnetTypeScript.Pages.Pages.latencyModel
@{
    ViewData["Title"] = "Latency</RWB>";
}
@section pagesComponents
{
    <script type="module" src="~/src/pagesComponents.js"></script>
}
<time datetime="2023-07-18">July 18, 2023</time>
<article id="LATENCY" class="WebBits">
    <h2>TRY: Measuring website latency</h2>
    <div class="columns">
        <p class="col-dl-12">
            The speed of light is 300,000,000 meters per second. Every
            millisecond, light travels 300,000 meters = 300km = 186 miles. Two
            computers connected over the internet experience this latency,
            accumulating 1 millisecond for every 186 miles in packet travel.
            This is a limitation of physics. It is immutable.
        </p>
        <form id="PropagationLatency" class="col-t-6 col-dl-6">
            <h3>Calculate Latency</h3>
            <label for="distance">Distance(km)</label>
            <input type="text" id="distance" placeholder="300 km" required>
            <label for="mediumSpeed">Medium Speed(m/s)</label>
            <input type="text" id="mediumSpeed" placeholder="300,000 m/s" required>
            <label for="packetSize">Packet Size(bytes)</label>
            <input type="text" id="packetSize" placeholder="1500 bytes">
            <label for="transmissionRate">Transmission Rate(kB/s)</label>
            <input type="text" id="transmissionRate" placeholder="1,000,000 Kbs">
            <div id="propagationcalcbtns">
                <div>
                    <button id="example1" class="propcalcbtn" type="button">
                        Ex. 1
                    </button>
                    <button id="example2" class="propcalcbtn" type="button">
                        Ex. 2
                    </button>
                    <button id="example3" class="propcalcbtn" type="button">
                        Ex. 3
                    </button>
                </div>
                <div>
                    <input id="reset" class="propcalcbtn" type="reset" value="Reset">
                    <input id="calculate" class="propcalcbtn" type="submit" value="Calculate">
                </div>
            </div>
            <details id="Formulas">
                <summary>Formulas<sup>1</sup>:</summary>
                <div class="formula">Propagation Delay <br> <var>P</var> = <var>Distance</var> / <var>Speed</var></div>
                <div class="formula">
                    Serialization Delay <br> <var>S</var> = <var>Packet Size (bits)</var> /
                    <var>Transmission Rate (bps)</var>
                </div>
                <div class="formula">Network Latency <br> <var>N</var> = <var>P</var> + <var>S</var></div>
            </details>
            <hr>
            <h4>Result:</h4>
            <div id="propcalcres">
                <output><i>Enter the variables and press calculate.</i></output>
            </div>
            <hr>
            <p class="citations">
                <strong>Citations:</strong><br>
                <sup>[1]</sup>
                <cite>
                    <a href="https://www.rfwireless-world.com/calculators/Network-Latency-Calculator.html"
                       rel="external noopener" target="_blank" title="Network Latency Formula">Network Latency Formula</a>
                </cite>
            </p>
        </form>
        <div class="col-dl-6">
            <aside class="examplePink">
                <h3>More about the speed of light:</h3>
                <ul>
                    <li>
                        <a href="https://www.nist.gov/si-redefinition/meet-constants" target="_blank" rel="external noopener"
                           title="Meet the Constants | NIST">Meet the Constants</a>
                    </li>
                    <li>
                        <a href="https://www.forbes.com/sites/quora/2016/11/07/how-do-we-measure-the-speed-of-light/?sh=7aed908b21d2"
                           target="_blank" rel="external noopener" title="How Do We Measure The Speed Of Light?">
                            How Do We Measure The
                            Speed Of Light?
                        </a>
                    </li>
                    <li>
                        <a href="https://interestingengineering.com/science/a-brief-history-of-the-speed-of-light"
                           target="_blank" rel="external noopener" title="Speed of Light: A Brief History of the Speed of Light">
                            A Brief
                            History of the Speed of Light
                        </a>
                    </li>
                </ul>
            </aside>
            <p class="col-dl-10 col-t-6">
                Latency should be accounted for when choosing an internet asset's
                location. <abbr title="Virtual Private Network">VPN</abbr> servers
                are fastest when the server is nearest your location. Web servers
                also have this advantage, although a web page's content can
                benefit from
                <abbr title="Content Management System">CMS</abbr> distribution
                specifically for this reason. Cms lowers travel latency caused by
                the 186 mile rule by storing, or caching, web content on a caching
                server nearest its users.
            </p>
            <aside class="exampleBlue col-dl-6">
                <p>Speed of light latency is 1 millisecond per 186 miles.</p>
            </aside>
        </div>
        <p>
            Critical sites, such as a business retail website, should consider
            travel latency in both operating and backup situations. For example,
            a frontend server operating in Miami expecting a failover server in
            Seattle experiences 18 milliseconds of travel latency. This means
            that a
            <abbr title="Transmission Control Protocol">TCP</abbr> connection -
            a TCP connection requires a three way handshake - alone would add
            54ms delay.
        </p>
        <acronyms-list></acronyms-list>
    </div>
</article>
<div class="Top-Link"><a class="Top" href="/pages/latency#top">Top</a></div>
