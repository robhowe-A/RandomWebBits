@page
<!--Copyright (c) 2025-2026 Robert A. Howell-->
@model RWBDotnetTypeScript.Pages.Pages.todosModel
@{
    ViewData["Title"] = "To-Do List</RWB>";
}
@section pagesComponents
{
    <script type="module" src="/src/pagesComponents.js"></script>
    <!-- FontAwesome -->
    <script src="https://kit.fontawesome.com/91ce0b8975.js" crossorigin="anonymous"></script>
}
<time datetime="2023-02-20">February 20, 2023</time>
<aside class="exampleBlue ToDoList">
    <p>Keep a list of things to do.</p>
    <div id="screensize"></div>
</aside>
<section id="ToDO">
    <h3>To-Do:</h3>
    <div>
        <table>
            <thead>
                <tr>
                    <th>Complete?</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody id="ToDoItems"></tbody>
            <tfoot>
                <tr>
                    <td>
                        <input id="AddButton" type="button" value="Add">
                    </td>
                    <td>
                        <input id="ToDoInput" name="itemINPUT" type="text" placeholder="New to-do item">
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</section>
<div class="Top-Link"><a class="Top" href="/pages/todos#top">Top</a></div>
@section widgetComponents
{
    <script type="module" src="/src/widgetComponents.js"></script>
}
@section Scripts {
    <script type="text/javascript">
        document.querySelector("body").classList.add("WebBits-width");
    </script>
}