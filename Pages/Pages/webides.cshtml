@model RWBDotnetTypeScript.Pages.Pages.webidesModel
@{
    ViewData["Title"] = "Browser IDE</RWB>";
}
@section pagesComponents
{
    <script type="module" src="~/src/pagesComponents.js"></script>
}
<time datetime="2023-05-02">May 2, 2023</time>
<article id="webIDE" class="WebBits">
    <h2>TRY: Testing different web IDE's</h2>
    <p>
        Many varieties of
        <abbr title="Integrated Development Environment">IDE</abbr> are
        available to download and use for free. Others operate in the browser,
        giving the same functionality without a need to download.
    </p>
    <section>
        <ul id="webIDECards">
            <li is="growing-card">
                <hgroup>
                    <h3>Brackets</h3>
                    <p><span class="spanAlert spanAlertPrice">Free</span></p>
                    <p>
                        <span class="spanAlert spanAlertGit">Git Integration</span>
                    </p>
                </hgroup>
                <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120">
                    <defs>
                        <linearGradient id="frame" gradientUnits="userSpaceOnUse" x1="433.5" y1="-185" x2="433.5" y2="-277"
                                        gradientTransform="matrix(1 0 0 -1 -373.5 -177)">
                            <stop offset="0" stop-color="#29abe2" />
                            <stop offset="0.4757" stop-color="#28a9e1" />
                            <stop offset="0.6639" stop-color="#23a2dc" />
                            <stop offset="0.8012" stop-color="#1a96d4" />
                            <stop offset="0.913" stop-color="#0e85c9" />
                            <stop offset="1" stop-color="#0071bc" />
                        </linearGradient>
                        <filter id="blur" x="-10" y="-10" width="12" height="12">
                            <feGaussianBlur in="SourceGraphic" stdDeviation="1" />
                        </filter>
                    </defs>
                    <rect x="10" y="9" width="100" height="100" rx="20" opacity=".5" filter="url(#blur)" />
                    <rect x="10" y="58" width="100" height="50" rx="20" fill="#115a91" />
                    <rect x="10" y="8" width="100" height="92" rx="20" fill="url(#frame)" />
                    <rect x="22" y="20" width="76" height="68" rx="10" fill="#fff" />
                    <path opacity=".5" filter="url(#blur)"
                          d="M57,29v12H43v26h14v13H30V29H57M90,28v51H63V67h15V41H63V29H90" />
                    <path fill="#4d4d4d" d="M57,28v12H43v26h14v13H30V28H57M90,28v51H63V66h15V40H63V28H90" />
                </svg>
                <p>
                    An easy modern text editor to design
                    <abbr title="Cascading Style Sheet">CSS</abbr> rules while
                    working with the website code live.
                </p>
                <a href="https://phcode.dev/" target="_blank" rel="external noopener"
                   title="index.html (default project) - Pheonix">https://phcode.dev/</a>
            </li>
            <li is="growing-card">
                <hgroup>
                    <h3>Codespaces</h3>
                    <p>
                        <span class="spanAlert spanAlertPrice">Free, limited</span>
                    </p>
                    <p>
                        <span class="spanAlert spanAlertGit">Git Integration</span>
                    </p>
                </hgroup>
                <img src="../library/img/webide__github-mark-white.png" alt="GitHub Codespaces IDE logo">
                <p>
                    To work alongside a GitHub repository, the codespace launches
                    the repository code live for browser editing.
                </p>
                <a href="https://github.com/features/codespaces" target="_blank" rel="external noopener"
                   title="GitHub Codespaces">https://github.com/features/codespaces</a>
            </li>
            <li is="growing-card">
                <hgroup>
                    <h3>Codio</h3>
                    <p>
                        <span class="spanAlert spanAlertPrice">Instructor Set</span>
                    </p>
                    <p>
                        <span class="spanAlert spanAlertFeatures">Advanced Features</span>
                    </p>
                </hgroup>
                <img src="../library/img/webide__codio.png" alt="Codio IDE logo">
                <p>
                    Used with modern learning spaces like Coursera, Codio features
                    their web IDE for educational and instructional purposes.
                </p>
                <a href="https://www.codio.com/" target="_blank" rel="external noopener"
                   title="Online IDE | Edit, Compile, & Run Code | Codio">https://www.codio.com/</a>
            </li>
            <li is="growing-card">
                <hgroup>
                    <h3>Cloud&nbsp;9</h3>
                    <p>
                        <span class="spanAlert spanAlertPrice">$1.00/90hours</span>
                    </p>
                    <p>
                        <span class="spanAlert spanAlertFeatures">Advanced Features</span>
                    </p>
                </hgroup>
                <img src="../library/img/webide__cloud9ide.png" alt="Coud9 IDE logo">
                <p>
                    Amazon &lpar;<abbr title="Amazon Web Services">AWS</abbr>&rpar;
                    cloud IDE with integrated cloud features.
                </p>
                <a href="https://aws.amazon.com/cloud9/pricing/" target="_blank" rel="external noopener"
                   title="AWS Cloud9 Details - Amazon Web Services">https://aws.amazon.com/cloud9/pricing/</a>
            </li>
            <li is="growing-card">
                <hgroup>
                    <h3>JSFiddle</h3>
                    <p><span class="spanAlert spanAlertPrice">Free</span></p>
                    <p>
                        <span class="spanAlert spanAlertGit">Easy collaboration</span>
                    </p>
                </hgroup>
                <img src="../library/img/webide__jsfiddle-logo.png" alt="JSFiddle IDE logo">
                <p>
                    This web application allows collaboration and sharing via links.
                    JSFiddle is often spotted throughout the web.
                </p>
                <a href="https://jsfiddle.net/" target="_blank" rel="external noopener"
                   title="JSFiddle - Code Playground">https://jsfiddle.net/</a>
            </li>
            <li is="growing-card">
                <hgroup>
                    <h3>Replit</h3>
                    <p><span class="spanAlert spanAlertPrice">Free</span></p>
                    <p>
                        <span class="spanAlert spanAlertGit">Easy collaboration</span>
                    </p>
                </hgroup>
                <img src="../library/img/webide__replit-logo-white.png" alt="Replit IDE logo">
                <p>
                    A modern look and feel, replit features a coding AI called
                    <i><q>Ghostwriter</q></i>
                </p>
                <a href="https://replit.com/" target="_blank" rel="external noopener"
                   title="Replit: the collaborative browser based IDE - Replit">https://replit.com/</a>
            </li>
        </ul>
    </section>
    <aside class="examplePink">
        <p>
            AWS Cloud 9 is a cloud IDE, with many additional features from cloud
            involvement.
        </p>
        <h4>cloudIDE &lpar;other&rpar;:</h4>
        <ol id="cloudIDEs">
            <li>
                <a href="https://codeanywhere.com/" target="_blank" rel="external noopener"
                   title="Cloud IDE * Online Code Editor * Codeanywhere">Codeanywhere</a>
            </li>
            <li>
                <a href="https://www.gitpod.io/" target="_blank" rel="external noopener"
                   title="Gitpod: Always ready to code.">Gitpod</a>
            </li>
            <li>
                <a href="https://cloud.google.com/shell/" target="_blank" rel="external noopener"
                   title="Cloud Shell | Google Cloud">Google Cloud Shell</a>
            </li>
        </ol>
    </aside>
</article>
<div class="Top-Link"><a class="Top" href="/pages/webides#top">Top</a></div>
@section Scripts {
    <script type="text/javascript">
        document.querySelector("body").setAttribute("id", "webIDE-B");
    </script>
}