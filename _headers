#root path
/
  Content-Security-Policy: script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; frame-ancestors 'self'
  Permissions-Policy: microphone=(), geolocation=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
#index page
/index.html
  Content-Security-Policy: script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; frame-ancestors 'self'
  Permissions-Policy: microphone=(), geolocation=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
#pages page
/pages.html
  Content-Security-Policy: script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; frame-ancestors 'self'
  Permissions-Policy: microphone=(), geolocation=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
#all pages
/pages/*
  Content-Security-Policy: script-src 'self' 'unsafe-inline' kit.fontawesome.com https://www.googletagmanager.com;
  Permissions-Policy: microphone=(), geolocation=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
#chatGPT page
/pages/chatGPT.html
  Content-Security-Policy: script-src 'self' 'unsafe-inline' kit.fontawesome.com https://www.googletagmanager.com cdn.jsdelivr.net;
  Permissions-Policy: microphone=(), geolocation=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
#images
/img/*
  X-Content-Type-Options: nosniff
/js/*
  X-Content-Type-Options: nosniff
/css/*
  X-Content-Type-Options: nosniff
